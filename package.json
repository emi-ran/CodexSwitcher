{
  "name": "codexswitcher",
  "version": "0.1.0",
  "description": "Windows account switcher and quota monitor for OpenAI Codex & ChatGPT Desktop",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "server": "node server.js",
    "build": "node scripts/build-exe.js",
    "build:exe": "node scripts/build-exe.js",
    "build:release": "electron-builder --win --x64 --publish never",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "app.codexswitcher.desktop",
    "productName": "CodexSwitcher",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": ["portable", "nsis", "msi"]
    },
    "portable": {
      "artifactName": "CodexSwitcher-${version}-portable-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "CodexSwitcher-${version}-setup-${arch}.${ext}"
    },
    "msi": {
      "artifactName": "CodexSwitcher-${version}-setup-${arch}.${ext}"
    }
  },
  "keywords": [
    "codex",
    "chatgpt",
    "switcher",
    "9router"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  }
}
